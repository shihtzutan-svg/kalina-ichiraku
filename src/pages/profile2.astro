---
import Layout from '../layouts/Layout.astro';
import bgGalaxy from '../assets/bg-galaxy.avif';

// ★テキストファイルを読み込む
import * as profile2Data from '../content/profile2.md';
const { frontmatter } = profile2Data;
---

<Layout 
  title={`${frontmatter.title} | プロフィール2 〜 西宮あすか - 公式サイト 〜 あなたの可能性を目醒めさせ、魂の変容・覚醒を支援する`}
  description={frontmatter.summary || "一樂迦哩無のプロフィールページその2。動物の家族や推し活についてなど、ありのままの姿をご紹介。"}
>
  <!-- 背景画像 -->
  <div class="bg-layer"></div>

  <!-- メインコンテンツ（中央配置の1カラムコンテナ） -->
  <main class="detailed-container">
    <section class="card-panel">
      <div class="profile-header-block">
        <p class="catchphrase">{frontmatter.catchphrase}</p>
        <h2>{frontmatter.title}</h2>
      </div>
      
      <div class="card-content detailed-story">
        {frontmatter.image && (
          <div class="toppage-image-container">
            <img src={frontmatter.image} alt={frontmatter.title} class="toppage-main-image" />
          </div>
        )}

        <div class="intro-message">
          <p class="greeting">{frontmatter.greeting}</p>
          <blockquote>
            {frontmatter.quote}
          </blockquote>
        </div>
        

        <!-- Markdownの本文（プロフィールストーリーやスキルなど）を自動展開 -->
        <div class="markdown-content">
        <profile2Data.Content />
       </div>

        <div class="back-home-container">
            <a href="/" class="back-home-link">トップページへ戻る</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<!-- ① 背景専用のスタイル -->
<style define:vars={{ bgUrl: `url(${bgGalaxy.src})` }}>
  .bg-layer {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background-image: var(--bgUrl); background-size: cover; background-position: center;
    z-index: -2; opacity: 1;
    animation: bgMovement 25s ease-in-out infinite alternate;
  }
  @keyframes bgMovement {
    0% { transform: scale(1) rotate(0deg); }
    100% { transform: scale(1.08) rotate(1deg); }
  }
</style>

<!-- ② ページ全体のメインスタイル（profile2 個別用） -->
<style>
  * { box-sizing: border-box; }
  body { 
    margin: 0; padding: 0;
    background: #f8f6fc; color: #1a1528; 
    font-family: 'Helvetica Neue', Arial, sans-serif;
    overflow-x: hidden;
    min-height: 100vh;
    display: flex; flex-direction: column;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* メインコンテンツコンテナ */
  .detailed-container {
    flex: 1;
    max-width: 900px; 
    margin: 140px auto 60px auto; 
    padding: 0 1.5rem;
    width: 100%;
  }
  
  /* カードパネル設定（白ベース・透け感グレー） */
  .card-panel {
    display: flex;
    flex-direction: column;
    justify-content: flex-start; 
    padding: 2rem 1.5rem !important;
    background: rgba(220, 220, 230, 0.45); 
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 20px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 15px 35px rgba(100, 90, 130, 0.15);
    box-sizing: border-box;
  }
  
  /* テキスト装飾 */
  .profile-header-block h2 { font-size: 2rem; margin-top: 0.2rem; margin-bottom: 2rem; color: #1a1528; font-weight: bold; }
  .catchphrase {
    color: #7232e0; font-size: 0.95rem; font-weight: bold; margin: 0; letter-spacing: 0.1em;
    white-space: pre-line;
  }

  .detailed-story p { 
    line-height: 1.85; margin-bottom: 1.4rem; color: #251f36; letter-spacing: 0.03em; font-weight: 500;
  }
  .intro-message .greeting { font-size: 1.15rem; font-weight: bold; color: #1a1528; }
  .intro-message blockquote {
    margin: 1.5rem 0; padding-left: 1.2rem; border-left: 3px solid #7232e0;
    font-style: italic; color: #1a1528; font-size: 1.1rem;
    white-space: pre-line;
  }

  /* ===================================================
     📚 Kindle書籍 紹介カード（2冊用コンテナ）
     =================================================== */
  .books-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 3.5rem 0;
  }

  .book-promo-card {
    display: flex !important;
    align-items: center !important;
    gap: 2.5rem !important;
    background: rgba(255, 255, 255, 0.75) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 16px !important;
    padding: 2.5rem !important;
    box-shadow: 0 8px 30px rgba(130, 110, 160, 0.12) !important;
    position: relative !important;
    overflow: hidden !important;
  }

  /* 書籍画像エリア */
  .book-img-area {
    flex: 0 0 160px !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
  }
  .book-cover-img {
    width: 100% !important;
    height: auto !important;
    border-radius: 6px !important;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15), 0 0 10px rgba(114, 50, 224, 0.1) !important;
    transition: transform 0.3s ease !important;
  }
  .book-promo-card:hover .book-cover-img {
    transform: translateY(-5px) scale(1.02) !important;
  }

  /* 書籍情報エリア */
  .book-info-area {
    flex: 1 !important;
    text-align: left !important;
  }

  /* 好評発売中バッジ */
  .book-promo-badge {
    display: inline-block !important;
    background: linear-gradient(90deg, #ff5e62, #ff9966) !important;
    color: #fff !important;
    font-size: 0.8rem !important;
    font-weight: bold !important;
    letter-spacing: 0.1em !important;
    padding: 0.3rem 1.2rem !important;
    border-radius: 20px !important;
    margin-bottom: 1rem !important;
    box-shadow: 0 0 10px rgba(255, 94, 98, 0.3) !important;
  }

  .source-badge {
    background: linear-gradient(90deg, #7232e0, #5028c6) !important;
    box-shadow: 0 0 10px rgba(114, 50, 224, 0.3) !important;
  }

  /* 書籍タイトル */
  .book-promo-title {
    font-size: 1.35rem !important;
    color: #1a1528 !important;
    margin: 0 0 0.8rem 0 !important;
    font-weight: bold !important;
    letter-spacing: 0.05em !important;
  }

  /* 書籍説明文 */
  .book-promo-description {
    font-size: 0.95rem !important;
    color: #251f36 !important;
    line-height: 1.7 !important;
    margin: 0 0 1.5rem 0 !important;
    font-weight: 500 !important;
  }

  .book-promo-card .action-buttons-container {
    margin: 0 !important;
    justify-content: flex-start !important;
  }
  
  /* 戻るリンク */
  .back-home-container { text-align: center; margin-top: 4rem; }
  .back-home-link { color: #554a66; text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: color 0.3s; }
  .back-home-link:hover { color: #7232e0; }

  /* マークダウン本文内のすべてのリンク（aタグ）を読みやすくネオン調に */
  .markdown-content :global(a) {
    color: #5028c6 !important;
    text-decoration: none !important;
    font-weight: bold !important;
    border-bottom: 1px dashed rgba(80, 40, 198, 0.6) !important;
    transition: all 0.3s ease !important;
  }
  .markdown-content :global(a:hover) {
    color: #7232e0 !important;
    border-bottom: 1px solid #7232e0 !important;
  }

  /* レスポンシブ対応 */
  @media (max-width: 768px) {
    .detailed-container { margin-top: 120px; }
    .card-panel { padding: 1.5rem; }
    .profile-header-block h2 { font-size: 1.6rem; }

    .book-promo-card {
      flex-direction: column !important;
      gap: 1.5rem !important;
      padding: 2rem 1.5rem !important;
    }
    .book-img-area {
      flex: 0 0 150px !important;
      max-width: 150px !important;
    }
    .book-info-area {
      text-align: center !important;
      width: 100% !important;
    }
    .book-promo-card .action-buttons-container {
      justify-content: center !important;
    }
  }
</style>

<!-- ✨ Markdownの中身を確実に装飾するためのグローバル指定 -->
<style is:global>
  .card-panel h3 {
    font-size: 1.35rem !important;
    color: #1a1528 !important;
    border-left: 3px solid #7232e0 !important;
    padding-left: 0.8rem !important;
    margin-top: 3.5rem !important;
    margin-bottom: 2rem !important;
    letter-spacing: 0.08em !important;
    background: none !important;
    font-weight: bold !important;
  }
  
  .card-panel h4 + ul {
    list-style: none !important;
    padding-left: 0 !important;
    margin: 0.8rem 0 2rem 0 !important;
    background: linear-gradient(to right, rgba(114, 50, 224, 0.06), transparent) !important;
    padding: 1rem 1.2rem !important;
    border-radius: 6px !important;
  }
  
  .card-panel ul li {
    position: relative !important;
    padding-left: 1.4rem !important;
    margin-bottom: 0.6rem !important;
    color: #251f36 !important;
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    background: none !important;
    border: none !important;
  }
  
  .card-panel ul li::before {
    content: "✦" !important;
    color: #7232e0 !important;
    position: absolute !important;
    left: 0 !important;
    top: -1px !important;
    font-size: 0.9rem !important;
    line-height: 1.4 !important;
    background: none !important;
    width: auto !important;
    height: auto !important;
  }

  .card-panel h4 {
    margin-top: 2rem !important;
    margin-bottom: 0.6rem !important;
    font-size: 1.1rem !important;
    color: #5028c6 !important;
    letter-spacing: 0.05em !important;
    font-weight: bold !important;
  }

  .card-panel h4 + p {
    line-height: 1.85 !important;
    color: #251f36 !important;
    margin-bottom: 2rem !important;
    letter-spacing: 0.03em !important;
    padding-left: 1.2rem !important;
    font-weight: 500 !important;
  }

  .card-panel hr {
    border: 0 !important;
    height: 1px !important;
    background: linear-gradient(to right, rgba(114, 50, 224, 0), rgba(114, 50, 224, 0.3), rgba(114, 50, 224, 0)) !important;
    margin: 3.5rem 0 !important;
  }

  .action-buttons-container {
    display: flex !important;
    justify-content: center !important;
    gap: 1.5rem !important;
    margin: 3.5rem 0 !important;
    width: 100% !important;
    flex-wrap: wrap !important;
  }

  .btn-action {
    flex: 1 !important;
    max-width: 320px !important;
    min-width: 260px !important;
    height: 56px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
    font-size: 1.05rem !important;
    font-weight: bold !important;
    letter-spacing: 0.05em !important;
    border-radius: 30px !important;
    position: relative !important;
    transition: all 0.4s ease !important;
    z-index: 1 !important;
    overflow: hidden !important;
    border: none !important;
  }

  .btn-action span {
    position: relative !important;
    z-index: 2 !important;
  }

  .btn-apply {
    background: linear-gradient(135deg, #7232e0, #5028c6) !important;
    color: #fff !important;
    box-shadow: 0 4px 15px rgba(114, 50, 224, 0.3) !important;
  }

  .btn-apply::before {
    content: '' !important;
    position: absolute !important;
    top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important;
    background: linear-gradient(135deg, #5028c6, #7232e0) !important;
    opacity: 0 !important;
    z-index: 1 !important;
    transition: opacity 0.4s ease !important;
  }

  .btn-apply:hover {
    transform: translateY(-3px) !important;
    box-shadow: 0 8px 25px rgba(114, 50, 224, 0.5) !important;
  }
  
  .btn-apply:hover::before {
    opacity: 1 !important;
  }

  .btn-apply:visited,
  .btn-apply:visited span {
    color: #fff !important;
  }

  @media (max-width: 600px) {
    .action-buttons-container {
      flex-direction: column !important;
      align-items: center !important;
      gap: 1.2rem !important;
    }
    .btn-action {
      width: 100% !important;
      max-width: 100% !important;
    }
  }
</style>

<!-- ③ メイン画像用コンテナスタイル -->
<style is:global>
  .toppage-image-container {
    width: 50%;
    margin: 0 auto 2rem auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 0 20px rgba(130, 110, 160, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.8);
  }
  .toppage-main-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .toppage-image-container {
      width: 80%;
    }
  }
</style>

<!-- 🖼️ 画像キャプション表示用スタイル -->
<style is:global>
.markdown-content p {
  line-height: 1.85 !important;
  color: #251f36 !important;
  margin-bottom: 1.4rem !important;
  font-weight: 500 !important;
}

.markdown-content .markdown-img-wrapper {
  display: block !important;
  width: 100% !important;
  max-width: 520px !important;
  margin: 2.5rem auto !important;
  padding: 0.8rem !important;
  background: rgba(255, 255, 255, 0.75) !important;
  border: 1px solid rgba(255, 255, 255, 0.95) !important;
  border-radius: 12px !important;
  box-shadow: 0 8px 24px rgba(130, 110, 160, 0.12) !important;
  box-sizing: border-box !important;
  clear: both !important;
}

.markdown-content .markdown-img-wrapper img {
  display: block !important;
  width: 100% !important;
  height: auto !important;
  margin: 0 !important;
  border-radius: 8px !important;
}

.markdown-content .img-caption-text {
  margin: 0.6rem 0 0.2rem 0 !important;
  font-size: 0.88rem !important;
  color: #5028c6 !important;
  text-align: center !important;
  line-height: 1.5 !important;
  font-weight: bold !important;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.markdown-content .youtube-container {
  position: relative !important;
  width: 100% !important;
  max-width: 600px !important;
  margin: 2.5rem auto !important;
  aspect-ratio: 16 / 9 !important;
  border-radius: 12px !important;
  overflow: hidden !important;
  box-shadow: 0 8px 24px rgba(130, 110, 160, 0.15) !important;
  border: 1px solid rgba(255, 255, 255, 0.8) !important;
}

.markdown-content .youtube-container iframe {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  border: none !important;
}

.markdown-content .spotify-container {
  width: 100% !important;
  max-width: 600px !important;
  margin: 2.5rem auto !important;
}

.markdown-content .spotify-container iframe {
  width: 100% !important;
  height: 352px !important;
  border-radius: 12px !important;
  border: none !important;
  box-shadow: 0 8px 24px rgba(130, 110, 160, 0.15) !important;
}
</style>

<!-- ⚡ 自動キャプション生成＆リンク制御スクリプト -->
<script is:inline>
function initProfile2Page() {
  const links = document.querySelectorAll('.book-promo-card .action-buttons-container a');
  links.forEach(link => {
    link.setAttribute('target', '_blank');
    link.setAttribute('rel', 'noopener noreferrer');
  });

  const markdownImgs = document.querySelectorAll('.markdown-content img');
  markdownImgs.forEach(img => {
    if (img.parentElement.classList.contains('markdown-img-wrapper')) return;

    let altText = img.getAttribute('alt') || '';
    const wrapper = document.createElement('div');
    wrapper.className = 'markdown-img-wrapper';

    altText = altText.replace(/::(left|right)/g, '').trim();

    img.parentNode.insertBefore(wrapper, img);
    wrapper.appendChild(img);

    if (altText !== '') {
      const caption = document.createElement('p');
      caption.className = 'img-caption-text';
      caption.textContent = altText;
      wrapper.appendChild(caption);
    }
  });
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initProfile2Page);
} else {
  initProfile2Page();
}

document.addEventListener('astro:page-load', initProfile2Page);
document.addEventListener('astro:after-swap', initProfile2Page);
</script>