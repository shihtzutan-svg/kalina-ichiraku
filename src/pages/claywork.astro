---
import bgGalaxy from '../assets/bg-galaxy.avif';
// 💡 Header のインポートを削除しました
import PageTop from '../components/PageTop.astro';
import Layout from '../layouts/Layout.astro'; 

import * as clayData from '../content/clay.md';
const { frontmatter } = clayData;
---

<Layout 
  title={`${frontmatter.title} | 一樂 迦哩無 - 公式サイト`}
  description={frontmatter.summary || "あなたの魂を解放する一樂 迦哩無の「クレイワーク・プログラム」。粘土をこねて作品を作ることで右脳を活性化し、思考の枠組みを超えた覚醒へアプローチします。ボディワークや誘導瞑想でハイヤーセルフと繋がり、潜在意識のブロックを外して本来の自分へ回帰します。"}
>
  <!-- 背景画像 -->
  <div class="bg-layer" style={`background-image: url(${bgGalaxy.src});`}></div>


  <!-- メインコンテンツ -->
  <main class="detailed-container">
    <section class="card-panel">
      <div class="program-header-block">
        <p class="catchphrase">{frontmatter.catchphrase}</p>
        <h2>{frontmatter.title}</h2>
      </div>
      
      <div class="card-content detailed-body">
        {frontmatter.image && (
          <div class="toppage-image-container">
            <img src={frontmatter.image} alt={frontmatter.title} class="toppage-main-image" />
          </div>
        )}
        <div class="summary-message">
          <p>{frontmatter.summary}</p>
        </div>

        <!-- Markdownの本文を自動展開 -->
        <div class="markdown-content">
          <clayData.Content />
        </div>
        
        <div class="back-home-container">
          <a href="/" class="back-home-link">トップページへ戻る</a>
        </div>
      </div>
    </section>
  </main>

  <PageTop />
</Layout>

<style>
  /* ① 背景専用のスタイル */
  .bg-layer {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover; background-position: center;
    z-index: -2; opacity: 0.7;
    pointer-events: none; 
    animation: bgMovement 25s ease-in-out infinite alternate;
  }
  @keyframes bgMovement {
    0% { transform: scale(1) rotate(0deg); }
    100% { transform: scale(1.08) rotate(1deg); }
  }

  /* ② ページ全体のメインスタイル */
  .detailed-container {
    flex: 1;
    max-width: 900px;
    margin: 140px auto 60px auto;
    padding: 0 1.5rem;
    width: 100%;
  }
  
  .card-panel {
    background: rgba(13, 11, 24, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px;
    padding: 2.5rem; backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }
  
  .program-header-block h2 { font-size: 2rem; margin-top: 0.2rem; margin-bottom: 2rem; }
  .catchphrase {
    color: #ffb7ff; font-size: 0.95rem; font-weight: bold; margin: 0; letter-spacing: 0.1em;
    white-space: pre-line;
  }
  .summary-message p { font-size: 1.1rem; line-height: 1.8; color: #fff; white-space: pre-line; }

  /* 💡 トップ画像スタイル */
  .toppage-image-container {
    width: 100%;
    margin: 0 auto 2rem auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 0 20px rgba(255, 183, 255, 0.2);
    border: 1px solid rgba(255, 183, 255, 0.3);
  }
  .toppage-main-image {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* 📚 マークダウン文章 */
  .markdown-content :global(p) {
    line-height: 1.95 !important; 
    margin-bottom: 1.8rem !important; 
    color: #dbd7e0 !important; 
    letter-spacing: 0.04em !important;
    font-size: 1.05rem !important;
  }

  .markdown-content :global(h3) {
    font-size: 1.3rem !important;
    color: #fff !important;
    border-left: 4px solid #d4af37 !important;
    padding-left: 12px !important;
    margin: 4rem 0 1.5rem 0 !important;
    letter-spacing: 0.05em !important;
    display: block !important;
  }
  .markdown-content :global(h3:first-of-type) { margin-top: 2rem !important; }

  /* 箇条書き（ul）リストスタイル */
  .markdown-content :global(ul) {
    display: flex !important;
    flex-direction: column !important;
    gap: 0 !important;
    margin: 2rem 0 !important;
    padding: 1.2rem 1.8rem !important;
    background: rgba(255, 255, 255, 0.03) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 16px !important;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2) !important;
    list-style: none !important;
  }

  .markdown-content :global(ul > li) {
    background: transparent !important;
    border: none !important;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08) !important;
    border-radius: 0 !important;
    padding: 1.1rem 0 1.1rem 2.2rem !important;
    margin: 0 !important;
    position: relative !important;
    box-shadow: none !important;
    list-style: none !important;
    font-size: 1.02rem !important;
    color: #ffffff !important;
    font-weight: 500 !important;
    line-height: 1.7 !important;
  }

  .markdown-content :global(ul > li:last-child) { border-bottom: none !important; }

  .markdown-content :global(ul > li::before) {
    content: '' !important;
    position: absolute !important;
    left: 0.4rem !important;
    top: 1.6rem !important;
    width: 8px !important;
    height: 8px !important;
    border-radius: 50% !important;
    background: linear-gradient(135deg, #ffb7ff, #7f00ff) !important;
    box-shadow: 0 0 8px rgba(255, 183, 255, 0.8) !important;
  }

  .markdown-content :global(ul > li strong) {
    color: #ffb7ff !important;
    font-weight: bold !important;
  }

  /* ===================================================
      ✨ スケジュール専用デザイン
     =================================================== */
  .markdown-content :global(.schedule-note) {
    font-size: 0.9rem !important;
    color: #aaa !important;
    margin-top: -0.5rem !important;
    margin-bottom: 2rem !important;
  }

  .markdown-content :global(.schedule-container) {
    display: flex !important;
    flex-direction: column !important;
    gap: 2rem !important;
    margin: 1.5rem 0 3rem 0 !important;
  }

  .markdown-content :global(.schedule-day) {
    background: rgba(255, 255, 255, 0.03) !important;
    border: 1px solid rgba(255, 183, 255, 0.2) !important;
    border-radius: 16px !important;
    padding: 1.8rem !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25) !important;
  }

  .markdown-content :global(.schedule-day h4) {
    font-size: 1.15rem !important;
    color: #ffb7ff !important;
    margin: 0 0 1.2rem 0 !important;
    font-weight: bold !important;
    letter-spacing: 0.05em !important;
    display: flex !important;
    align-items: center !important;
  }

  .markdown-content :global(.schedule-list) {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.8rem !important;
  }

  .markdown-content :global(.schedule-list li) {
    display: flex !important;
    align-items: center !important;
    gap: 1rem !important;
    padding: 0.8rem 1rem !important;
    background: rgba(0, 0, 0, 0.2) !important;
    border-radius: 10px !important;
    border: 1px solid rgba(255, 255, 255, 0.05) !important;
  }

  .markdown-content :global(.step-num) {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 28px !important;
    height: 28px !important;
    background: linear-gradient(135deg, #ffb7ff, #7f00ff) !important;
    color: #fff !important;
    font-weight: bold !important;
    font-size: 0.85rem !important;
    border-radius: 50% !important;
    flex-shrink: 0 !important;
    box-shadow: 0 0 8px rgba(255, 183, 255, 0.4) !important;
  }

  .markdown-content :global(.step-text) {
    color: #ffffff !important;
    font-size: 1rem !important;
  }

  .markdown-content :global(.step-text strong) {
    color: #ffb7ff !important;
    font-weight: normal !important;
    font-size: 0.95rem !important;
    margin-left: 0.3rem !important;
  }

  /* 🧘 引用ブロック */
  .markdown-content :global(blockquote) {
    margin: 1.8rem 0 !important;
    padding: 1.2rem 1.5rem !important;
    background: rgba(255, 183, 255, 0.08) !important;
    border: 1px solid rgba(255, 183, 255, 0.3) !important;
    border-radius: 12px !important;
    color: #ffffff !important;
    text-align: center !important;
  }
  .markdown-content :global(blockquote p) { margin: 0 !important; }

  /* 🖼️ 画像スタイル */
  .markdown-content :global(img) {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    border-radius: 12px !important;
    margin: 2rem auto !important;
    display: block !important;
  }

  .markdown-content :global(img.small-img) {
    width: 50% !important;
    max-width: 280px !important;
  }

  .markdown-content :global(img.voice-img) {
    width: 60% !important;
    max-width: 450px !important;
  }

  .markdown-content :global(hr) {
    border: 0 !important;
    height: 1px !important;
    background: linear-gradient(to right, rgba(255,255,255,0), rgba(255, 183, 255, 0.4), rgba(255,255,255,0)) !important;
    margin: 3.5rem 0 !important;
  }

  /* 🔘 ボタンエリア */
  .markdown-content :global(.action-buttons-container) {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 1rem !important;
    margin: 3rem auto !important;
  }
  .markdown-content :global(.btn-action) {
    width: 100% !important;
    max-width: 320px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
    color: #fff !important;
    font-weight: bold !important;
    height: 52px !important;
    border-radius: 30px !important;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .markdown-content :global(.btn-action:hover) {
    transform: translateY(-2px);
    opacity: 0.9;
  }
  .markdown-content :global(.btn-apply) {
    background: linear-gradient(90deg, #ff7e5f, #feb47b) !important;
    box-shadow: 0 4px 15px rgba(255, 126, 95, 0.35) !important;
  }
  .markdown-content :global(.btn-contact) {
    background: rgba(255, 255, 255, 0.04) !important;
    border: 2px solid #ffb7ff !important;
    color: #ffb7ff !important;
  }

  .back-home-container { text-align: center; margin-top: 4rem; }
  .back-home-link { color: #aaa; text-decoration: none; font-size: 0.95rem; }
  .back-home-link:hover { color: #ffb7ff; }

  @media (max-width: 768px) {
    .detailed-container { margin-top: 100px; }
    .card-panel { padding: 1.5rem; }
    .markdown-content :global(img.small-img) { width: 70% !important; }
    .markdown-content :global(img.voice-img) { width: 85% !important; }
  }
</style>