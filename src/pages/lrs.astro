---
import Layout from '../layouts/Layout.astro';
import * as lrsData from '../content/lrs.md';
import bgGalaxy from '../assets/bg-galaxy.avif';
const { frontmatter } = lrsData;
---

<Layout
  title={`${frontmatter.title} | ライフ・リバイブ・セッション 〜 西宮あすか - 公式サイト 〜 あなたの可能性を目醒めさせ、魂の変容・覚醒を支援する`}
  description={frontmatter.summary || "人生を棚卸しし、今までと違う自分に生まれ変わる ライフ・リバイバー（人生蘇生士）による覚醒セッション"}
>
  <div class="bg-layer" style={`background-image: url(${bgGalaxy.src});`}></div>

  <!-- メインコンテンツ -->
  <main class="detailed-container">
    <section class="card-panel">
      <div class="program-header-block">
        <p class="catchphrase">{frontmatter.catchphrase}</p>
        <h2>{frontmatter.title}</h2>
      </div>
      
      <div class="card-content detailed-body">
        {frontmatter.image && (
          <div class="toppage-image-container">
            <img src={frontmatter.image} alt="メインイメージ" class="toppage-main-image" />
          </div>
        )}

        <div class="summary-message">
          <p>{frontmatter.summary}</p>
        </div>

        <hr class="divider" />

        <!-- Markdownの本文を自動展開 -->
        <div class="markdown-content">
          <lrsData.Content />
        </div>
        
        <div class="back-home-container">
          <a href="/" class="back-home-link">トップページへ戻る</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<!-- ページ全体のメインスタイル -->
<style>
- { box-sizing: border-box; }

  .bg-layer {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover; background-position: center;
    z-index: -2; 
    opacity: 1;
    animation: bgMovement 25s ease-in-out infinite alternate;
  }
  @keyframes bgMovement {
    0% { transform: scale(1) rotate(0deg); }
    100% { transform: scale(1.08) rotate(1deg); }
  }

  /* コンテナ */
  .detailed-container {
    flex: 1;
    max-width: 950px;
    margin: 140px auto 60px auto;
    padding: 0 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }
  
  /* 全体カードパネル */
  .card-panel {
    display: flex;
    flex-direction: column;
    justify-content: flex-start; 
    background: rgba(220, 220, 230, 0.45); 
    border: 1px solid rgba(255, 255, 255, 0.8); 
    border-radius: 20px;
    padding: 3.5rem; 
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 15px 35px rgba(100, 90, 130, 0.15);
    overflow: hidden;
  }
  
  /* テキスト・見出し装飾 */
  .program-header-block h2 { 
    font-size: 2.2rem; 
    margin-top: 0.5rem; 
    margin-bottom: 1.5rem; 
    color: #1a1528;
    font-weight: bold;
    letter-spacing: 0.05em;
  }
  .catchphrase {
    color: #7232e0;
    font-size: 1.05rem;
    font-weight: bold;
    margin: 0;
    letter-spacing: 0.15em;
    white-space: pre-line;
  }
  .summary-message p { 
    font-size: 1.1rem; 
    line-height: 1.85; 
    color: #251f36;
    font-weight: 500;
    white-space: pre-line;
  }
  
  .divider {
    border: 0;
    height: 1px;
    background: linear-gradient(to right, rgba(114, 50, 224, 0), rgba(114, 50, 224, 0.3), rgba(114, 50, 224, 0));
    margin: 3rem 0;
  }

  /* 戻るリンク */
  .back-home-container { text-align: center; margin-top: 4rem; }
  .back-home-link { color: #554a66; text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: all 0.3s; }
  .back-home-link:hover { color: #7232e0; }

  @media (max-width: 768px) {
    .detailed-container { margin-top: 100px; }
    .card-panel { padding: 1.5rem; }
    .program-header-block h2 { font-size: 1.7rem; }
  }

  /* ===================================================
     📚 マークダウン本文の完全統合スタイリング（service.astro準拠）
     =================================================== */

  /* 大見出し（##）：左側のパープル縦線アクセント */
  .markdown-content :global(h2) {
    font-size: 1.45rem !important;
    color: #1a1528 !important;
    border-left: 4px solid #7232e0 !important;
    padding-left: 14px !important;
    margin: 2.5rem 0 1.5rem 0 !important;
    font-weight: bold !important;
    letter-spacing: 0.05em !important;
  }

  /* 中見出し（###）：濃いパープル */
  .markdown-content :global(h3) {
    font-size: 1.2rem !important;
    color: #5028c6 !important;
    margin: 2rem 0 1rem 0 !important;
    font-weight: bold !important;
  }

  .markdown-content :global(p) {
    line-height: 1.85 !important;
    color: #251f36 !important;
    margin-bottom: 1.2rem !important;
    font-weight: 500 !important;
  }

  /* 既存の<strong>設定（青色の強調） */
  .markdown-content :global(strong) {
    color: #053ffd !important;
    font-weight: bold !important;
  }

  /* 追加：黒色の強調用クラス（<strong class="strong-black">） */
  .markdown-content :global(strong.strong-black) {
    color: #1a1528 !important;
    font-weight: bold !important;
  }

  .markdown-content :global(hr) {
    border: 0 !important;
    height: 1px !important;
    background: linear-gradient(to right, transparent, rgba(114, 50, 224, 0.3), transparent) !important;
    margin: 2.5rem 0 !important;
  }

  /* ---------------------------------------------------
     ③ ご予約の流れ（STEPバッジ＋フローデザイン）
     --------------------------------------------------- */
  .markdown-content :global(.step-list) {
    list-style: none !important;
    padding: 0 !important;
    margin: 1.5rem 0 2rem 0 !important;
  }

  .markdown-content :global(.step-list > li) {
    background: rgba(255, 255, 255, 0.88) !important;
    border: 1px solid rgba(114, 50, 224, 0.25) !important;
    border-radius: 16px !important;
    padding: 1.4rem 1.8rem !important;
    margin-bottom: 2.6rem !important;
    position: relative !important;
    backdrop-filter: blur(10px) !important;
    box-shadow: 0 6px 20px rgba(130, 110, 160, 0.1) !important;
  }

  .markdown-content :global(.step-list > li:last-child) {
    margin-bottom: 1.8rem !important;
  }

  /* STEPバッジ（グラデーションラベル） */
  .markdown-content :global(.step-badge) {
    display: inline-block !important;
    background: linear-gradient(135deg, #5028c6, #7232e0) !important;
    color: #fff !important;
    font-size: 0.82rem !important;
    font-weight: bold !important;
    letter-spacing: 0.08em !important;
    padding: 0.25rem 0.9rem !important;
    border-radius: 20px !important;
    margin-bottom: 0.7rem !important;
    box-shadow: 0 3px 10px rgba(114, 50, 224, 0.25) !important;
  }

  .markdown-content :global(.step-list > li > p) {
    margin: 0 !important;
    font-size: 0.98rem !important;
    color: #251f36 !important;
    font-weight: 500 !important;
    line-height: 1.75 !important;
  }

  /* STEPカードの真下の矢印（▼） */
  .markdown-content :global(.step-list > li:not(:last-child)::after) {
    content: "▼" !important;
    position: absolute !important;
    bottom: -2.05rem !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    font-size: 1.5rem !important;
    color: #7232e0 !important;
    text-shadow: 0 0 10px rgba(114, 50, 224, 0.25) !important;
  }

  /* 注意書きボックス（軽やかなアクセント枠） */
  .markdown-content :global(.note-box) {
    background: rgba(243, 238, 255, 0.85) !important;
    border-left: 4px solid #7232e0 !important;
    border-radius: 8px !important;
    padding: 1rem 1.4rem !important;
    margin: 1.5rem 0 2rem 0 !important;
  }

  .markdown-content :global(.note-box p) {
    margin: 0 !important;
    font-size: 0.92rem !important;
    color: #3a2e56 !important;
    line-height: 1.7 !important;
  }

  /* お支払い方法・お支払い期限（2列コンパクトカード） */
  .markdown-content :global(.payment-grid) {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 1.2rem !important;
    margin: 1.5rem 0 1rem 0 !important;
  }

  .markdown-content :global(.payment-item) {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(245, 242, 255, 0.85) 100%) !important;
    border: 1px solid rgba(114, 50, 224, 0.3) !important;
    border-radius: 14px !important;
    padding: 1.4rem 1.6rem !important;
    text-align: center !important;
    box-shadow: 0 6px 20px rgba(130, 110, 160, 0.1) !important;
  }

  .markdown-content :global(.payment-item h4) {
    color: #053ffd !important;
    font-size: 1rem !important;
    font-weight: bold !important;
    margin: 0 0 0.6rem 0 !important;
    padding-bottom: 0.5rem !important;
    border-bottom: 1px dashed rgba(114, 50, 224, 0.25) !important;
  }

  .markdown-content :global(.payment-item p) {
    margin: 0 !important;
    font-size: 1.05rem !important;
    font-weight: bold !important;
    color: #1a1528 !important;
  }

  @media (max-width: 768px) {
    .markdown-content :global(.payment-grid) {
      grid-template-columns: 1fr !important;
    }
  }

  /* ---------------------------------------------------
     ① おすすめの方リスト（チェックリストカード：クラスなしulのみに適用）
     --------------------------------------------------- */
  .markdown-content :global(ul:not([class])) {
    padding: 0 !important;
    list-style: none !important;
    margin: 1.5rem 0 !important;
  }

  .markdown-content :global(ul:not([class]) > li) {
    background: rgba(255, 255, 255, 0.75) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 12px !important;
    padding: 1rem 1.2rem 1rem 2.8rem !important;
    margin-bottom: 0.8rem !important;
    position: relative !important;
    font-size: 0.95rem !important;
    color: #251f36 !important;
    font-weight: 500 !important;
    backdrop-filter: blur(6px) !important;
  }

  .markdown-content :global(ul:not([class]) > li::before) {
    content: "✔" !important;
    position: absolute !important;
    left: 1rem !important;
    top: 1rem !important;
    color: #3f2ac6 !important;
    font-weight: bold !important;
  }

  /* ---------------------------------------------------
     ② スクリーンショット準拠の二重囲み枠カード（.feature-card）
     --------------------------------------------------- */
  .markdown-content :global(.feature-card) {
    background: rgba(255, 255, 255, 0.82) !important;
    border: 1px solid rgba(114, 50, 224, 0.25) !important;
    border-radius: 16px !important;
    padding: 1.8rem !important;
    margin-bottom: 1.5rem !important;
    backdrop-filter: blur(10px) !important;
    box-shadow: 0 8px 25px rgba(130, 110, 160, 0.12) !important;
  }

  /* 枠内の見出し（画像と同じロイヤルブルー） */
  .markdown-content :global(.feature-card h4) {
    color: #053ffd !important;
    font-size: 1.12rem !important;
    font-weight: bold !important;
    margin: 0 0 1rem 0 !important;
    letter-spacing: 0.03em !important;
  }

  /* 枠内のテキストボックス（画像の「・数多くの〜」の白ボックスに相当） */
  .markdown-content :global(.feature-inner) {
    background: rgba(255, 255, 255, 0.72) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 10px !important;
    padding: 1.2rem 1.4rem !important;
  }

  .markdown-content :global(.feature-inner p) {
    margin-bottom: 0.9rem !important;
    font-size: 0.96rem !important;
    line-height: 1.8 !important;
    color: #251f36 !important;
  }

  .markdown-content :global(.feature-inner p:last-child) {
    margin-bottom: 0 !important;
  }

  /* ---------------------------------------------------
     枠内の箇条書きリスト（料金に含まれるもの・注意事項）
     --------------------------------------------------- */
  .markdown-content :global(.inner-list) {
    list-style: none !important;
    padding: 0 !important;
    margin: 1rem 0 1.2rem 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.55rem !important;
  }

  .markdown-content :global(.inner-list li) {
    position: relative !important;
    padding: 0.7rem 1rem 0.7rem 2.3rem !important;
    margin-bottom: 0 !important;
    font-size: 0.95rem !important;
    color: #251f36 !important;
    font-weight: 500 !important;
    line-height: 1.65 !important;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(244, 239, 255, 0.85) 100%) !important;
    border: 1px solid rgba(114, 50, 224, 0.2) !important;
    border-radius: 10px !important;
    box-shadow: 0 3px 10px rgba(130, 110, 160, 0.06) !important;
  }

  .markdown-content :global(.inner-list li::before) {
    content: "✓" !important;
    position: absolute !important;
    left: 0.85rem !important;
    top: 0.68rem !important;
    color: #5028c6 !important;
    font-weight: bold !important;
    font-size: 0.95rem !important;
  }

  .markdown-content :global(.inner-list li:last-child) {
    margin-bottom: 0 !important;
  }

  /* キャンセル・日程変更のリスト表示を見やすく整形 */
  .markdown-content :global(.feature-card h4 + .feature-inner p) {
    line-height: 1.85 !important;
  }

    /* 画像通常設定 */
  .markdown-content :global(img) {
    width: 100% !important; height: auto !important; border-radius: 12px !important;
    box-shadow: 0 8px 24px rgba(130, 110, 160, 0.15) !important; margin: 2rem 0 !important;
  }
  .markdown-content :global(img[alt="クレイワークのイメージ"]) {
    width: 30% !important; max-width: 450px !important; height: auto !important;
    margin: 2rem auto !important; display: block !important;
  }
  .markdown-content :global(img[alt="受講生の声"]) {
    width: 70% !important; max-width: 450px !important; height: auto !important;
    margin: 2rem auto !important; display: block !important;
  }

  @media (max-width: 768px) {
    .markdown-content :global(ul:has(ul) > li) {
      flex: 1 1 100% !important;
    }
  }

  /* ===================================================
     ✨ お申し込みボタン
     =================================================== */
  .markdown-content :global(.action-buttons-container) {
    display: flex !important;
    justify-content: center !important;
    margin: 3.5rem 0 1.5rem 0 !important;
    width: 100% !important;
  }

  .markdown-content :global(.btn-action) {
    width: 100% !important;
    max-width: 380px !important;
    height: 60px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
    font-size: 1.1rem !important;
    font-weight: bold !important;
    letter-spacing: 0.08em !important;
    border-radius: 30px !important;
    position: relative !important;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
    z-index: 1 !important;
    overflow: hidden !important;
    border: none !important;
    color: #fff !important;
  }

  .markdown-content :global(.btn-action span) {
    position: relative !important;
    z-index: 2 !important;
    color: #fff !important;
  }

  .markdown-content :global(.btn-town-link) {
    background: linear-gradient(135deg, #00f2fe, #4facfe) !important;
    box-shadow: 0 4px 20px rgba(0, 242, 254, 0.3) !important;
  }

  .markdown-content :global(.btn-town-link::before) {
    content: '' !important;
    position: absolute !important;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(135deg, #7f00ff, #e100ff) !important;
    opacity: 0 !important;
    z-index: 1 !important;
    transition: opacity 0.4s ease !important;
  }

  .markdown-content :global(.btn-town-link:hover) {
    transform: translateY(-3px) scale(1.02) !important;
    box-shadow: 0 8px 30px rgba(127, 0, 255, 0.5), 0 0 15px rgba(0, 242, 254, 0.3) !important;
  }
  
  .markdown-content :global(.btn-town-link:hover::before) {
    opacity: 1 !important;
  }

  @media (max-width: 768px) {
    .markdown-content :global(.feature-card) {
      padding: 1.2rem !important;
    }
    .markdown-content :global(.feature-inner) {
      padding: 1rem !important;
    }
  }
</style>

<!-- グローバル用の独立スタイル（画像サイズ制御） -->
<style is:global>
  .toppage-image-container {
    width: 100%;
    max-height: 440px;
    margin: 0 auto 2rem auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 0 20px rgba(130, 110, 160, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.8);
  }
  .toppage-main-image {
    width: 100%;
    max-height: 440px;
    height: auto;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  @media (max-width: 768px) {
    .toppage-image-container,
    .toppage-main-image {
      max-height: 300px;
    }
  }
</style>

<script is:inline>
  function setupFormButtons() {
    const links = document.querySelectorAll('.action-buttons-container a');
    links.forEach(link => {
      link.setAttribute('target', '_blank');
      link.setAttribute('rel', 'noopener noreferrer');
    });
  }

  setupFormButtons();
  document.addEventListener('astro:page-load', setupFormButtons);
</script>