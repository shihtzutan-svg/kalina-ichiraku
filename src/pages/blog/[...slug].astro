---
import bgGalaxy from '../../assets/bg-galaxy.avif';
import PageTop from '../../components/PageTop.astro';
import Layout from '../../layouts/Layout.astro';
import { getBlogs, getBlogDetail } from '../../library/microcms';

// 1. microCMSから全記事のIDを取得して静的パスを生成
export async function getStaticPaths() {
  const response = await getBlogs({ fields: ["id"] });
  return response.contents.map((content) => ({
    params: { slug: content.id },
  }));
}

// 2. URLパラメータ（slug = microCMSのコンテンツID）から詳細データを取得
const { slug } = Astro.params;
const blog = await getBlogDetail(slug as string);

const pageTitle = `${blog.title} | 西宮あすか - 公式サイト`;
---

<Layout title={pageTitle}>
  <!-- 背景画像 -->
  <div class="bg-layer"></div>

  <!-- メインコンテンツ -->
  <main class="detailed-container">
    <section class="card-panel">
      <div class="program-header-block">
        <h2>{blog.title}</h2>
        <div class="blog-meta">
          <time datetime={blog.publishedAt}>
            📅 {new Date(blog.publishedAt || blog.createdAt).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>
      
      <div class="card-content detailed-body">
        {blog.eyecatch?.url && (
          <div class="toppage-image-container">
            <img src={blog.eyecatch.url} alt={blog.title} class="toppage-main-image" />
          </div>
        )}

        <hr class="divider" />
        
        {/* microCMSのリッチテキスト（HTML）を自動展開 */}
        <div class="markdown-content" set:html={blog.content} />
        
        <div class="back-home-container">
          <a href="/blog" class="back-home-link">← ブログ一覧へ戻る</a>
        </div>
      </div>
    </section>
  </main>

  <PageTop />
</Layout>

<!-- スタイル設定 -->
<!-- ① 背景専用のスタイル -->
<style define:vars={{ bgUrl: `url(${bgGalaxy.src})` }}>
  .bg-layer {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background-image: var(--bgUrl); background-size: cover; background-position: center;
    z-index: -2; opacity: 1;
    animation: bgMovement 25s ease-in-out infinite alternate;
  }
  @keyframes bgMovement {
    0% { transform: scale(1) rotate(0deg); }
    100% { transform: scale(1.08) rotate(1deg); }
  }
</style>

<!-- ② ページ全体のメインスタイル（白ベース・透け感グレー・濃い文字色） -->
<style>
  * { box-sizing: border-box; }
  body { 
    margin: 0; padding: 0;
    background: #f8f6fc; color: #1a1528; 
    font-family: 'Helvetica Neue', Arial, sans-serif;
    overflow-x: hidden;
    min-height: 100vh;
    display: flex; flex-direction: column;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* コンテナ */
  .detailed-container {
    flex: 1;
    max-width: 900px;
    margin: 140px auto 60px auto;
    padding: 0 1.5rem;
    width: 100%;
  }
  
  .card-panel {
    display: flex;
    flex-direction: column;
    justify-content: flex-start; 
    background: rgba(220, 220, 230, 0.45); 
    border: 1px solid rgba(255, 255, 255, 0.8); 
    border-radius: 20px;
    padding: 2.5rem; 
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 15px 35px rgba(100, 90, 130, 0.15);
    overflow: hidden;
  }
  
  /* テキスト・見出し・メタデータ装飾 */
  .program-header-block h2 { 
    font-size: 2rem; 
    margin-top: 0.2rem; 
    margin-bottom: 0.8rem; 
    color: #1a1528;
    font-weight: bold;
    line-height: 1.4;
  }
  .blog-meta { margin-bottom: 2rem; }
  .blog-meta time { color: #7232e0; font-size: 0.95rem; font-weight: bold; }
  
  .catchphrase {
    color: #7232e0; font-size: 0.95rem; font-weight: bold; margin: 0; letter-spacing: 0.1em;
    white-space: pre-line;
  }
  .summary-message p { font-size: 1.1rem; line-height: 1.8; color: #251f36; font-weight: 500;
    white-space: pre-line;
  }
  
  .divider {
    border: 0; height: 1px;
    background: linear-gradient(to right, rgba(114, 50, 224, 0), rgba(114, 50, 224, 0.3), rgba(114, 50, 224, 0));
    margin: 2.5rem 0;
  }

  /* 画像領域 */
  .toppage-image-container {
    width: 100%;
    max-height: 450px;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 2rem;
    box-shadow: 0 8px 24px rgba(130, 110, 160, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.8);
  }
  .toppage-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 戻るリンク */
  .back-home-container { text-align: center; margin-top: 4rem; }
  .back-home-link { color: #554a66; text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: color 0.3s; }
  .back-home-link:hover { color: #7232e0; }

  @media (max-width: 768px) {
    .detailed-container { margin-top: 120px; }
    .card-panel { padding: 1.5rem; }
    .program-header-block h2 { font-size: 1.6rem; }
  }

  /* ===================================================
     ★重要：本文（HTML/リッチテキスト）の中身の装飾
     =================================================== */
  .markdown-content :global(p) {
    line-height: 1.9 !important; 
    margin-bottom: 1.4rem !important; 
    color: #251f36 !important; 
    letter-spacing: 0.03em !important;
    font-size: 1.05rem !important;
    font-weight: 500 !important;
  }

  /* 本文内のリンク */
  .markdown-content :global(a) {
    color: #5028c6 !important;
    text-decoration: none !important;
    font-weight: bold !important;
    border-bottom: 1px dashed rgba(80, 40, 198, 0.6) !important;
    transition: all 0.3s ease !important;
  }
  .markdown-content :global(a:hover) {
    color: #7232e0 !important;
    border-bottom: 1px solid #7232e0 !important;
  }

  /* 見出し (h3) */
  .markdown-content :global(h3) {
    font-size: 1.35rem !important;
    color: #1a1528 !important;
    border-left: 4px solid #7232e0 !important;
    padding-left: 12px !important;
    margin: 3.5rem 0 1.5rem 0 !important;
    letter-spacing: 0.05em !important;
    display: block !important;
    font-weight: bold !important;
  }
  .markdown-content :global(h3:first-of-type) {
    margin-top: 2rem !important;
  }

  /* 🎨 メリットカード（ul層） */
  .markdown-content :global(ul) {
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)) !important;
    gap: 1.2rem !important;
    margin: 2rem 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  .markdown-content :global(ul li) {
    background: rgba(255, 255, 255, 0.75) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 12px !important;
    padding: 1.2rem 1.5rem 1.2rem 1.8rem !important;
    position: relative !important;
    overflow: hidden !important;
    font-size: 0.95rem !important;
    line-height: 1.6 !important;
    color: #251f36 !important;
    font-weight: 500 !important;
    list-style-type: none !important;
  }

  .markdown-content :global(ul > li::before) {
    content: '' !important;
    position: absolute !important;
    top: 0 !important; left: 0 !important; bottom: 0 !important; width: 6px !important;
    height: 100% !important;
  }
  .markdown-content :global(ul > li:nth-child(1)::before) { background: linear-gradient(to bottom, #ff9966, #ff5e62) !important; }
  .markdown-content :global(ul > li:nth-child(2)::before) { background: linear-gradient(to bottom, #f5af19, #f12711) !important; }
  .markdown-content :global(ul > li:nth-child(3)::before) { background: linear-gradient(to bottom, #00c6ff, #0072ff) !important; }
  .markdown-content :global(ul > li:nth-child(4)::before) { background: linear-gradient(to bottom, #7232e0, #5028c6) !important; }
  .markdown-content :global(ul > li:nth-child(5)::before) { background: linear-gradient(to bottom, #11998e, #38ef7d) !important; }
  .markdown-content :global(ul > li:nth-child(6)::before) { background: linear-gradient(to bottom, #00f2fe, #4facfe) !important; }

  .markdown-content :global(ul li strong) {
    color: #7232e0 !important;
    font-weight: bold !important;
  }

  /* ⏰ スケジュール・小見出し (h4) */
  .markdown-content :global(h4) {
    color: #5028c6 !important;
    font-size: 1.1rem !important;
    margin: 2.5rem 0 0.5rem 0 !important;
    padding: 0 !important;
    position: relative !important;
    display: block !important;
    margin-bottom: 0.5rem !important;
    z-index: 1 !important;
    font-weight: bold !important;
  }

  .markdown-content :global(ol) {
    background: rgba(255, 255, 255, 0.75) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 12px !important;
    padding: 1.5rem 1.5rem 1.5rem 2.5rem !important;
    margin: 0.5rem 0 2.5rem 0 !important;
    list-style-type: decimal !important;
    display: block !important;
    clear: both !important;
  }

  .markdown-content :global(ol li) {
    background: none !important;
    border: none !important;
    padding: 0 !important;
    margin: 0.8rem 0 !important;
    font-size: 0.95rem !important;
    color: #251f36 !important;
    font-weight: 500 !important;
    line-height: 1.6 !important;
  }
  .markdown-content :global(ol li::before) { display: none !important; content: none !important; }
  .markdown-content :global(ol li::marker) { font-size: 1rem !important; color: #7232e0 !important; font-weight: bold !important; }

  /* 🎨 持ち物リスト */
  .markdown-content :global(ul:has(ul)) {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: wrap !important;
    justify-content: space-between !important;
    gap: 1.5rem !important;
    margin: 2rem 0 3rem 0 !important;
    padding: 0 !important;
    list-style-type: none !important;
  }

  .markdown-content :global(ul:has(ul) > li) {
    flex: 0 1 calc(50% - 0.75rem) !important;
    min-width: 300px !important;
    background: rgba(255, 255, 255, 0.75) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 12px !important;
    padding: 1.5rem 2rem 2rem 2rem !important;
    overflow: visible !important;
    list-style-type: none !important;
    display: block !important;
    position: relative !important;
  }
  .markdown-content :global(ul:has(ul) > li::marker) { display: none !important; content: none !important; }

  .markdown-content :global(ul:has(ul) > li::before) {
    content: '' !important;
    position: absolute !important;
    top: 0 !important; left: 0 !important; bottom: 0 !important; width: 6px !important;
    height: 100% !important;
    background: linear-gradient(to bottom, #ff9966, #ff5e62) !important;
  }
  .markdown-content :global(ul:has(ul) > li:nth-of-type(2)::before) { 
    background: linear-gradient(to bottom, #f5af19, #f12711) !important; 
  }

  /* ===================================================
     🖼️ 本文内の画像スタイル
     =================================================== */
  .markdown-content :global(img) {
    max-width: 100% !important; 
    height: auto !important;     
    display: block !important;
    margin: 2rem auto !important; 
    border-radius: 12px !important; 
    box-shadow: 0 8px 24px rgba(130, 110, 160, 0.15) !important; 
    border: 1px solid rgba(255, 255, 255, 0.8) !important; 
  }
</style>