---
import bgGalaxy from '../../assets/bg-galaxy.avif';
import PageTop from '../../components/PageTop.astro';
import Layout from '../../layouts/Layout.astro';
import { getBlogs } from '../../library/microcms';

// microCMSからブログ記事一覧を取得
const response = await getBlogs({
  fields: ["id", "title", "publishedAt", "eyecatch"]
});
const blogPosts = response.contents;

const pageTitle = "ブログ一覧 | 西宮あすか - 公式サイト";
---

<Layout title={pageTitle}>
  <!-- 背景画像 -->
  <div class="bg-layer" style={`background-image: url(${bgGalaxy.src});`}></div>

  <!-- メインコンテンツ -->
  <main class="detailed-container">
    <section class="card-panel">
      <div class="program-header-block">
        <p class="catchphrase">BLOG POSTS</p>
        <h2>ブログ記事一覧</h2>
      </div>
      
      <div class="card-content detailed-body">
        <div class="blog-grid-list">
          {blogPosts.map((post) => (
            <article class="blog-list-item">
              {post.eyecatch && (
                <a href={`/blog/${post.id}`} class="blog-item-thumb-link">
                  <img src={post.eyecatch.url} alt={post.title} class="blog-item-thumb" />
                </a>
              )}
              <div class="blog-item-body">
                <p class="blog-item-date">
                  📅 {new Date(post.publishedAt).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                </p>
                <h3 class="blog-item-title">
                  <a href={`/blog/${post.id}`}>{post.title}</a>
                </h3>
                <a href={`/blog/${post.id}`} class="blog-item-more">記事を読む →</a>
              </div>
            </article>
          ))}
        </div>

        <hr class="divider" />
        
        <div class="back-home-container">
          <a href="/" class="back-home-link">トップページへ戻る</a>
        </div>
      </div>
    </section>
  </main>

  <PageTop />
</Layout>

<!-- スタイル設定 -->
<!-- ① 背景専用のスタイル -->
<style define:vars={{ bgUrl: `url(${bgGalaxy.src})` }}>
  .bg-layer {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover; background-position: center;
    z-index: -2; 
    opacity: 1; 
    animation: bgMovement 25s ease-in-out infinite alternate;
  }
  @keyframes bgMovement {
    0% { transform: scale(1) rotate(0deg); }
    100% { transform: scale(1.08) rotate(1deg); }
  }
</style>

<!-- ② ページ全体のメインスタイル（白ベース・透け感グレーに統一） -->
<style is:global>
  * { box-sizing: border-box; }
  body { 
    margin: 0; padding: 0;
    background: #f8f6fc; color: #1a1528; 
    font-family: 'Helvetica Neue', Arial, sans-serif;
    overflow-x: hidden;
    min-height: 100vh;
    display: flex; flex-direction: column;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* コンテナ */
  .detailed-container {
    flex: 1;
    max-width: 900px;
    margin: 140px auto 60px auto;
    padding: 0 1.5rem;
    width: 100%;
  }
  
  .card-panel {
    display: flex;
    flex-direction: column;
    justify-content: flex-start; 
    background: rgba(220, 220, 230, 0.45); 
    border: 1px solid rgba(255, 255, 255, 0.8); 
    border-radius: 20px;
    padding: 2.5rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 15px 35px rgba(100, 90, 130, 0.15);
    overflow: hidden;
  }
  
  .program-header-block h2 { 
    font-size: 2rem; 
    margin-top: 0.2rem; 
    margin-bottom: 2rem; 
    color: #1a1528;
    font-weight: bold;
  }
  .catchphrase {
    color: #7232e0; font-size: 0.95rem; font-weight: bold; margin: 0; letter-spacing: 0.1em;
    white-space: pre-line;
  }

  .divider {
    border: 0; height: 1px;
    background: linear-gradient(to right, rgba(114, 50, 224, 0), rgba(114, 50, 224, 0.3), rgba(114, 50, 224, 0));
    margin: 2.5rem 0;
  }

  /* 🏡 トップへ戻るリンク */
  .back-home-container { text-align: center; margin-top: 4rem; }
  .back-home-link { color: #554a66; text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: color 0.3s; }
  .back-home-link:hover { color: #7232e0; }

  /* 📝 ブログ一覧の独自レイアウト */
  .blog-grid-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }

  .blog-list-item {
    display: flex;
    gap: 2rem;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 8px 25px rgba(130, 110, 160, 0.12);
    align-items: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .blog-list-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(130, 110, 160, 0.2);
  }

  .blog-item-thumb-link {
    flex: 0 0 220px;
    height: 140px;
    border-radius: 10px;
    overflow: hidden;
    display: block;
    box-shadow: 0 4px 15px rgba(130, 110, 160, 0.15);
  }
  .blog-item-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .blog-item-thumb-link:hover .blog-item-thumb {
    transform: scale(1.05);
  }

  .blog-item-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .blog-item-date {
    color: #7232e0;
    font-size: 0.85rem;
    font-weight: bold;
    margin: 0 0 0.5rem 0;
  }

  .blog-item-title {
    font-size: 1.25rem;
    margin: 0 0 0.8rem 0;
    font-weight: bold;
    line-height: 1.4;
  }
  .blog-item-title a {
    color: #1a1528;
    text-decoration: none;
    transition: color 0.2s;
  }
  .blog-item-title a:hover {
    color: #5028c6;
  }

  .blog-item-more {
    color: #5028c6;
    text-decoration: none;
    font-weight: bold;
    font-size: 0.9rem;
    align-self: flex-start;
    transition: color 0.2s;
  }
  .blog-item-more:hover {
    color: #7232e0;
  }

  /* 📱 スマホ対応 */
  @media (max-width: 768px) {
    .detailed-container { margin-top: 120px; }
    .card-panel { padding: 1.5rem; }
    .program-header-block h2 { font-size: 1.6rem; }

    .blog-list-item {
      flex-direction: column;
      gap: 1rem;
      padding: 1.2rem;
    }
    .blog-item-thumb-link {
      flex: none;
      width: 100%;
      height: 180px;
    }
    .blog-item-title {
      font-size: 1.15rem;
    }
  }
</style>