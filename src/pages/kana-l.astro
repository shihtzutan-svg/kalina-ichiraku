---
import bgGalaxy from '../assets/bg-galaxy.avif';
import Layout from '../layouts/Layout.astro'; 
import PageTop from '../components/PageTop.astro';
import * as kanaLData from '../content/kana-l.md';
const { frontmatter } = kanaLData;
---

<Layout 
  title={`${frontmatter.title} |宇宙天使「Kana-L（カナエル）」  〜 西宮あすか - 公式サイト 〜 あなたの可能性を目醒めさせ、魂の変容・覚醒を支援する`}
  description={frontmatter.summary || "あなたの願いを叶えるマスコット、宇宙天使「Kana-L（カナエル）」。西宮あすかが万物の根源である「源」と繋がり、一つひとつ手作りしました。願いを託し、可愛がることで波動を高め、あなたの理想の現実創造を優しくサポートします。"}
>
  <!-- 背景画像 -->
  <div class="bg-layer"></div>

  <!-- メインコンテンツ -->
  <main class="detailed-container">
    <section class="card-panel">
      <div class="program-header-block">
        <p class="catchphrase">{frontmatter.catchphrase}</p>
        <h2>{frontmatter.title}</h2>
      </div>
      
      <div class="card-content detailed-body">
        {frontmatter.image && (
          <div class="toppage-image-container">
            <img src={frontmatter.image} alt={frontmatter.title} class="toppage-main-image" />
          </div>
        )}

        <div class="summary-message">
          <p>{frontmatter.summary}</p>
        </div>

        <hr class="divider" />
        <!-- Markdownの本文（特徴、おすすめの人、内容など）を自動展開 -->
        <div class="markdown-content">
          <kanaLData.Content />
        </div>
        
        <div class="back-home-container">
          <a href="/" class="back-home-link">トップページへ戻る</a>
        </div>
      </div>
    </section>
  </main>

  <PageTop />
</Layout>

<!-- スタイル設定 -->
<!-- ① 背景専用のスタイル -->
<style define:vars={{ bgUrl: `url(${bgGalaxy.src})` }}>
  .bg-layer {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background-image: var(--bgUrl); background-size: cover; background-position: center;
    z-index: -2; opacity: 1;
    animation: bgMovement 25s ease-in-out infinite alternate;
  }
  @keyframes bgMovement {
    0% { transform: scale(1) rotate(0deg); }
    100% { transform: scale(1.08) rotate(1deg); }
  }
</style>

<!-- ② ページ全体のメインスタイル（白ベース・透け感グレー・濃い文字色） -->
<style>
  * { box-sizing: border-box; }
  body { 
    margin: 0; padding: 0;
    background: #f8f6fc; color: #1a1528; 
    font-family: 'Helvetica Neue', Arial, sans-serif;
    overflow-x: hidden;
    min-height: 100vh;
    display: flex; flex-direction: column;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* コンテナ */
  .detailed-container {
    flex: 1;
    max-width: 900px;
    margin: 140px auto 60px auto;
    padding: 0 1.5rem;
    width: 100%;
  }
  
  .card-panel {
    display: flex;
    flex-direction: column;
    justify-content: flex-start; 
    padding: 2rem 1.5rem !important;
    background: rgba(220, 220, 230, 0.45); 
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 20px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 15px 35px rgba(100, 90, 130, 0.15);
    box-sizing: border-box;
    overflow: hidden;
  }
  
  /* テキスト・見出し装飾 */
  .program-header-block h2 { font-size: 2rem; margin-top: 0.2rem; margin-bottom: 2rem; color: #1a1528; font-weight: bold; }
  .catchphrase {
    color: #7232e0; font-size: 0.95rem; font-weight: bold; margin: 0; letter-spacing: 0.1em;
    white-space: pre-line;
  }
  .summary-message p { font-size: 1.1rem; line-height: 1.8; color: #251f36; font-weight: 500;
    white-space: pre-line;
  }
  
  .divider {
    border: 0 !important; height: 1px !important;
    background: linear-gradient(to right, rgba(114, 50, 224, 0), rgba(114, 50, 224, 0.3), rgba(114, 50, 224, 0)) !important;
    margin: 2.5rem 0;
  }

  .markdown-content :global(hr) {
    border: 0 !important; height: 1px !important;
    background: linear-gradient(to right, rgba(114, 50, 224, 0), rgba(114, 50, 224, 0.3), rgba(114, 50, 224, 0)) !important;
    margin: 3.5rem 0 !important;
  }

/* ===================================================
    📚 マークダウン本文の最適化装飾
    =================================================== */
  .markdown-content :global(p) {
    line-height: 1.95 !important; 
    margin-bottom: 1.8rem !important; 
    color: #251f36 !important; 
    letter-spacing: 0.04em !important;
    font-size: 1.05rem !important;
    font-weight: 500 !important;
  }

  /* マークダウン本文内のすべてのリンク（aタグ） */
  .markdown-content :global(a) {
    color: #5028c6 !important;
    text-decoration: none !important;
    font-weight: bold !important;
    border-bottom: 1px dashed rgba(80, 40, 198, 0.6) !important;
    transition: all 0.3s ease !important;
  }
  .markdown-content :global(a:hover) {
    color: #7232e0 !important;
    border-bottom: 1px solid #7232e0 !important;
  }

  /* 戻るリンク */
  .back-home-container { text-align: center; margin-top: 4rem; }
  .back-home-link { color: #554a66; text-decoration: none; font-size: 0.95rem; font-weight: 600; transition: color 0.3s; }
  .back-home-link:hover { color: #7232e0; }

  @media (max-width: 768px) {
    .detailed-container { margin-top: 120px; }
    .card-panel { padding: 1.5rem; }
    .program-header-block h2 { font-size: 1.6rem; }
  }

  /* ===================================================
    ★重要：マークダウンの中身の装飾
    =================================================== */
  
  .markdown-content :global(p) {
    line-height: 1.85 !important; margin-bottom: 1.4rem !important; color: #251f36 !important; letter-spacing: 0.03em !important; font-weight: 500 !important;
  }

  /* 見出し (h3) */
  .markdown-content :global(h3) {
    font-size: 1.3rem !important;
    color: #1a1528 !important;
    border-left: 4px solid #7232e0 !important;
    padding-left: 12px !important;
    margin: 4rem 0 1.5rem 0 !important;
    letter-spacing: 0.05em !important;
    display: block !important;
    font-weight: bold !important;
  }
  .markdown-content :global(h3:first-of-type) {
    margin-top: 2rem !important;
  }

  /* ---------------------------------------------------
    🎨 リストカード層
    --------------------------------------------------- */
  .markdown-content :global(ul) {
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)) !important;
    gap: 1.2rem !important;
    margin: 2rem 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  .markdown-content :global(ul li) {
    background: rgba(255, 255, 255, 0.75) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 12px !important;
    padding: 1.2rem 1.5rem 1.2rem 1.8rem !important;
    position: relative !important;
    overflow: hidden !important;
    font-size: 0.95rem !important;
    line-height: 1.6 !important;
    color: #251f36 !important;
    list-style-type: none !important;
    font-weight: 500 !important;
  }

  .markdown-content :global(ul > li::before) {
    content: '' !important;
    position: absolute !important;
    top: 0 !important; left: 0 !important; bottom: 0 !important; width: 6px !important;
    height: 100% !important;
  }
  .markdown-content :global(ul > li:nth-child(1)::before) { background: linear-gradient(to bottom, #ff9966, #ff5e62) !important; }
  .markdown-content :global(ul > li:nth-child(2)::before) { background: linear-gradient(to bottom, #f5af19, #f12711) !important; }
  .markdown-content :global(ul > li:nth-child(3)::before) { background: linear-gradient(to bottom, #00c6ff, #0072ff) !important; }
  .markdown-content :global(ul > li:nth-child(4)::before) { background: linear-gradient(to bottom, #7232e0, #5028c6) !important; }
  .markdown-content :global(ul > li:nth-child(5)::before) { background: linear-gradient(to bottom, #11998e, #38ef7d) !important; }
  .markdown-content :global(ul > li:nth-child(6)::before) { background: linear-gradient(to bottom, #00f2fe, #4facfe) !important; }

  .markdown-content :global(ul li strong) {
    color: #7232e0 !important;
    font-weight: bold !important;
  }

  /* ---------------------------------------------------
    ⏰ スケジュール（h4 ＋ 番号付きリスト ol）
    --------------------------------------------------- */
  .markdown-content :global(h4) {
    color: #7232e0 !important;
    font-size: 1.05rem !important;
    margin: 2.5rem 0 0.5rem 0 !important;
    padding: 0 !important;
    position: relative !important;
    display: block !important;
    margin-bottom: 0.5rem !important;
    z-index: 1 !important;
    font-weight: bold !important;
  }

  .markdown-content :global(ol) {
    background: rgba(255, 255, 255, 0.75) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 12px !important;
    padding: 1.5rem 1.5rem 1.5rem 2.5rem !important;
    margin: 0.5rem 0 2.5rem 0 !important;
    list-style-type: decimal !important;
    display: block !important;
    clear: both !important;
  }

  .markdown-content :global(ol li) {
    background: none !important;
    border: none !important;
    padding: 0 !important;
    margin: 0.8rem 0 !important;
    font-size: 0.95rem !important;
    color: #251f36 !important;
    line-height: 1.6 !important;
    font-weight: 500 !important;
  }
  .markdown-content :global(ol li::before) { display: none !important; content: none !important; }
  .markdown-content :global(ol li::marker) { font-size: 1rem !important; color: #7232e0 !important; font-weight: bold !important; }

  /* ===================================================
    🎨 持ち物リスト（2列レイアウト＆帯消去）
    =================================================== */
  .markdown-content :global(ul:has(ul)) {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: wrap !important;
    justify-content: space-between !important;
    gap: 1.5rem !important;
    margin: 2rem 0 3rem 0 !important;
    padding: 0 !important;
    list-style-type: none !important;
  }

  .markdown-content :global(ul:has(ul) > li) {
    flex: 0 1 calc(50% - 0.75rem) !important;
    min-width: 300px !important;
    background: rgba(255, 255, 255, 0.75) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 12px !important;
    padding: 1.5rem 2rem 2rem 2rem !important;
    overflow: visible !important;
    list-style-type: none !important;
    display: block !important;
  }
  .markdown-content :global(ul:has(ul) > li::marker) { display: none !important; content: none !important; }

  .markdown-content :global(ul:has(ul) > li::before) {
    content: '' !important;
    position: absolute !important;
    top: 0 !important; left: 0 !important; bottom: 0 !important; width: 6px !important;
    height: 100% !important;
    background: linear-gradient(to bottom, #ff9966, #ff5e62) !important;
  }
  .markdown-content :global(ul:has(ul) > li:nth-of-type(2)::before) { 
    background: linear-gradient(to bottom, #f5af19, #f12711) !important; 
  }

  .markdown-content :global(ul:has(ul) ul) {
    display: block !important;
    margin: 0.5rem 0 0 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  .markdown-content :global(ul:has(ul) ul li) {
    background: rgba(255, 255, 255, 0.6) !important;
    border: 1px solid rgba(255, 255, 255, 0.9) !important;
    border-radius: 8px !important;
    padding: 0.9rem 1.2rem 0.9rem 2.8rem !important;
    margin: 0.6rem 0 !important;
    position: relative !important;
    font-size: 0.95rem !important;
    color: #251f36 !important;
    overflow: visible !important;
    list-style-type: none !important;
    display: block !important;
    font-weight: 500 !important;
  }
  .markdown-content :global(ul:has(ul) ul li::marker) { display: none !important; content: none !important; }

  .markdown-content :global(ul:has(ul) ul li::before) {
    content: '✓' !important;
    position: absolute !important;
    left: 1.2rem !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    font-weight: bold !important;
    font-size: 1.1rem !important;
    background: none !important;
    width: auto !important;
    height: auto !important;
  }
  .markdown-content :global(ul:has(ul) > li:nth-of-type(1) ul li::before) { color: #ff5e62 !important; }
  .markdown-content :global(ul:has(ul) > li:nth-of-type(2) ul li::before) { color: #7232e0 !important; }

  /* ===================================================
    🎨 料金セクション
    =================================================== */
  .markdown-content :global(h4) + :global(ul) {
    display: block !important;
    background: rgba(255, 255, 255, 0.75) !important;
    border: 1px solid rgba(255, 255, 255, 0.95) !important;
    border-radius: 16px !important;
    padding: 5.5rem 2rem 2rem 2rem !important;
    margin: 0 0 3.5rem 0 !important;
    box-shadow: 0 8px 32px rgba(130, 110, 160, 0.12) !important;
    position: relative !important;
    overflow: hidden !important;
    list-style: none !important;
  }
  
  .markdown-content :global(main) .markdown-content :global(h4):has(+ ul),
  .markdown-content :global(h4):has(+ ul) {
    margin-top: 3.5rem !important;
    margin-bottom: -4.5rem !important;
    position: relative !important;
    z-index: 10 !important;
    padding-left: 2rem !important;
    font-size: 1.15rem !important;
    font-weight: bold !important;
    color: #7232e0 !important;
    display: block !important;
  }

  .markdown-content :global(h4) + :global(ul)::before {
    content: '' !important;
    position: absolute !important;
    top: 0 !important; left: 0 !important; bottom: 0 !important; width: 6px !important;
    z-index: 5 !important;
    height: 100% !important;
  }
  
  .markdown-content :global(h4:nth-of-type(1)):has(+ ul) + :global(ul)::before,
  .markdown-content :global(h4):has(+ ul) + :global(ul)::before {
    background: linear-gradient(to bottom, #ff9966, #ff5e62) !important;
  }
  .markdown-content :global(ul) + :global(h4):has(+ ul) + :global(ul)::before {
    background: linear-gradient(to bottom, #f5af19, #f12711) !important;
  }

  .markdown-content :global(h4) + :global(ul) li {
    background: rgba(255, 255, 255, 0.6) !important;
    border: 1px solid rgba(255, 255, 255, 0.9) !important;
    border-radius: 12px !important;
    padding: 1.5rem 2rem !important;
    margin: 0 !important;
    width: 100% !important;
    font-size: 1.05rem !important;
    color: #1a1528 !important;
    overflow: hidden !important;
    position: relative !important;
    list-style-type: none !important;
    display: block !important;
    font-weight: 500 !important;
  }
  .markdown-content :global(h4) + :global(ul) li::marker { display: none !important; content: none !important; }
  .markdown-content :global(h4) + :global(ul) li::before {
    display: none !important;
    content: none !important;
    background: none !important;
  }

  /* 引用ブロック装飾 */
  .markdown-content :global(blockquote) {
    border-left: 4px solid #7232e0 !important;
    background: rgba(114, 50, 224, 0.05) !important;
    padding: 1rem 1.5rem !important;
    margin: 2.5rem 0 !important;
    border-radius: 0 8px 8px 0 !important;
  }
  .markdown-content :global(blockquote p) { margin: 0 !important; color: #1a1528 !important; font-size: 0.95rem !important; font-weight: 500 !important; }

  /* 画像通常設定 */
  .markdown-content :global(img) {
    width: 100% !important; height: auto !important; border-radius: 12px !important;
    box-shadow: 0 8px 24px rgba(130, 110, 160, 0.15) !important; margin: 2rem 0 !important;
  }
  .markdown-content :global(img[alt="クレイワークのイメージ"]) {
    width: 30% !important; max-width: 450px !important; height: auto !important;
    margin: 2rem auto !important; display: block !important;
  }
  .markdown-content :global(img[alt="受講生の声"]) {
    width: 70% !important; max-width: 450px !important; height: auto !important;
    margin: 2rem auto !important; display: block !important;
  }

  @media (max-width: 768px) {
    .markdown-content :global(ul:has(ul) > li) {
      flex: 1 1 100% !important;
    }
  }

  /* ===================================================
    ✨ Kana-L（カナエル）ページ専用：拡張スタイル
    =================================================== */
  .markdown-content :global(.kanal-steps h4) {
    margin-top: 2rem !important;
    margin-bottom: 0.4rem !important;
  }

  .markdown-content :global(.example-tag) {
    display: inline-block;
    background: rgba(114, 50, 224, 0.08) !important;
    color: #7232e0 !important;
    border: 1px dashed rgba(114, 50, 224, 0.3) !important;
    padding: 0.4rem 1rem !important;
    border-radius: 6px !important;
    font-size: 0.9rem !important;
    margin-top: 0.5rem !important;
    font-weight: bold !important;
  }

  /* チャージ方法・料金の見た目 */
  .markdown-content :global(.kanal-charge-section ul) {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.6rem !important;
    margin: 1rem 0 2rem 0 !important;
    padding: 0 !important;
    background: none !important;
    border: none !important;
    box-shadow: none !important;
  }

  .markdown-content :global(.kanal-charge-section ul li) {
    background: none !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 0 0 0 1.2rem !important;
    margin: 0 !important;
    font-size: 0.95rem !important;
    color: #251f36 !important;
    overflow: visible !important;
    font-weight: 500 !important;
  }

  .markdown-content :global(.kanal-charge-section ul li::before) {
    content: '•' !important;
    color: #7232e0 !important;
    position: absolute !important;
    left: 0 !important;
    top: 0 !important;
    font-size: 1.2rem !important;
    line-height: 1.5 !important;
    background: none !important;
    width: auto !important;
    height: auto !important;
  }

  .markdown-content :global(.kanal-price-text) {
    color: #7232e0 !important;
    font-size: 1.05rem !important;
    font-weight: bold !important;
    letter-spacing: 0.05em;
  }

  /* ===================================================
    🎨 ボタン
    =================================================== */
  .markdown-content :global(.action-buttons-container) {
    display: flex !important;
    justify-content: center !important;
    gap: 1.5rem !important;
    margin: 3.5rem 0 !important;
    width: 100% !important;
    flex-wrap: wrap !important;
  }

  .markdown-content :global(.btn-action) {
    flex: 1 !important;
    max-width: 320px !important;
    min-width: 260px !important;
    height: 56px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
    font-size: 1.05rem !important;
    font-weight: bold !important;
    letter-spacing: 0.05em !important;
    border-radius: 30px !important;
    position: relative !important;
    transition: all 0.4s ease !important;
    z-index: 1 !important;
    overflow: hidden !important;
    border: none !important;
  }

  .markdown-content :global(.btn-action span) {
    position: relative !important;
    z-index: 2 !important;
  }

  .markdown-content :global(.btn-apply) {
    background: linear-gradient(135deg, #7232e0, #5028c6) !important;
    color: #fff !important;
    box-shadow: 0 4px 15px rgba(114, 50, 224, 0.3) !important;
  }

  .markdown-content :global(.btn-apply::before) {
    content: '' !important;
    position: absolute !important;
    top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important;
    background: linear-gradient(135deg, #5028c6, #7232e0) !important;
    opacity: 0 !important;
    z-index: 1 !important;
    transition: opacity 0.4s ease !important;
  }

  .markdown-content :global(.btn-apply:hover) {
    transform: translateY(-3px) !important;
    box-shadow: 0 8px 25px rgba(114, 50, 224, 0.5) !important;
  }
  
  .markdown-content :global(.btn-apply:hover::before) {
    opacity: 1 !important;
  }

  .markdown-content :global(.btn-contact) {
    background: rgba(255, 255, 255, 0.75) !important;
    color: #7232e0 !important;
    border: 2px solid #7232e0 !important;
    box-shadow: 0 4px 15px rgba(114, 50, 224, 0.1) !important;
  }

  .markdown-content :global(.btn-contact:hover) {
    transform: translateY(-3px) !important;
    background: #7232e0 !important;
    color: #fff !important;
    box-shadow: 0 8px 25px rgba(114, 50, 224, 0.4) !important;
  }

  @media (max-width: 600px) {
    .markdown-content :global(.action-buttons-container) {
      flex-direction: column !important;
      align-items: center !important;
      gap: 1.2rem !important;
    }
    .markdown-content :global(.btn-action) {
      width: 100% !important;
      max-width: 100% !important;
    }
  }

  /* ===================================================
    🙋 よくあるご質問（FAQ）セクション
    =================================================== */
  .markdown-content :global(.kanal-faq-section) {
    margin-top: 2rem !important;
  }

  .markdown-content :global(.kanal-faq-section h4) {
    font-size: 1.1rem !important;
    margin-top: 3.5rem !important;
    margin-bottom: 1rem !important;
    border-bottom: 1px solid rgba(114, 50, 224, 0.2) !important;
    padding-bottom: 0.6rem !important;
  }

  .markdown-content :global(.kanal-faq-section h4:first-of-type) {
    margin-top: 1.5rem !important;
  }

  .markdown-content :global(.kanal-faq-section p) {
    margin-bottom: 1.2rem !important;
    font-size: 0.95rem !important;
    color: #251f36 !important;
    font-weight: 500 !important;
  }

  /* 訪問済みリンク */
  .markdown-content :global(a:visited) {
    color: #5028c6 !important;
  }

  .markdown-content :global(.btn-apply:visited),
  .markdown-content :global(.btn-apply:visited span) {
    color: #fff !important;
  }

  .markdown-content :global(.btn-contact:visited),
  .markdown-content :global(.btn-contact:visited span) {
    color: #7232e0 !important;
  }
  .markdown-content :global(.btn-contact:hover:visited) {
    color: #fff !important;
  }
</style>

