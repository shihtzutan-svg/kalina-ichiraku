---
// src/pages/tokushouho.astro
import bgGalaxy from '../assets/bg-galaxy.avif';
import Layout from '../layouts/Layout.astro';
import PageTop from '../components/PageTop.astro';

const pageTitle = "特定商取引法に基づく表記 | 西宮あすか - 公式サイト";
---

<Layout title={pageTitle}>
  <!-- 背景画像 -->
  <div class="bg-layer" style={`background-image: url(${bgGalaxy.src});`}></div>

  <!-- メインコンテンツ -->
  <main class="detailed-container">
    <section class="card-panel">
      <div class="program-header-block">
        <p class="catchphrase">COMMERCIAL TRANSACTIONS LAW</p>
        <h2>特定商取引法に基づく表記</h2>
      </div>
      
      <div class="card-content detailed-body">
        <div class="tokushouho-table-wrapper">
          <table class="tokushouho-table">
            <tbody>
              <tr>
                <th>販売事業者</th>
                <td>西宮あすか（取引時に請求があれば、遅滞なく本名を開示いたします。）</td>
              </tr>
              <tr>
                <th>運営責任者</th>
                <td>西宮あすか（取引時に請求があれば、遅滞なく本名を開示いたします。）</td>
              </tr>
              <tr>
                <th>所在地</th>
                <td>取引時に請求があれば、遅滞なく電磁的記録等（メール等）にて開示いたします。</td>
              </tr>
              <tr>
                <th>電話番号</th>
                <td>取引時に請求があれば、遅滞なく電磁的記録等（メール等）にて開示いたします。</td>
              </tr>
              <tr>
                <th>連絡先（お問い合わせ）</th>
                <td class="markdown-content">
                  <a href="https://forms.gle/S4YanYgGCeFCjhqr8" target="_blank" rel="noopener noreferrer">
                    お問い合わせフォームはこちら
                  </a>
                  <br />
                  <span class="table-notice">
                    ※お問い合わせは上記フォームより24時間受け付けております。
                  </span>
                </td>
              </tr>
              <tr>
                <th>販売価格</th>
                <td>各商品の詳細ページに表示された価格（消費税込み）</td>
              </tr>
              <tr>
                <th>商品代金以外の必要料金</th>
                <td>銀行振込の場合、銀行振込手数料</td>
              </tr>
              <tr>
                <th>お支払方法</th>
                <td>銀行振込</td>
              </tr>
              <tr>
                <th>代金の支払時期</th>
                <td>
                  ご注文後5日以内にお振込みください。
                </td>
              </tr>
              <tr>
                <th>役務（セッション・ワークショップ）の提供時期</th>
                <td>
                  決済完了確認後、2営業日以内にメールにて実施日時の調整（または参加方法）のご案内を送信いたします。
                </td>
              </tr>
              <tr>
                <th>キャンセル・日程変更</th>
                <td>
                  セッション・ワークショップ日の7日前まで：キャンセルの場合は100%返金（振込手数料を除く）／日程変更は可能<br />
                  セッション・ワークショップ日の2日前〜前日まで：キャンセルの場合は80%返金（振込手数料を除く）／日程変更は可能<br />
                  当日ご連絡あり：キャンセルの場合は50%返金（振込手数料を除く）／日程変更は可能<br />
                  当日ご連絡なし：返金なし／日程変更・再申し込み不可<br />
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <hr class="divider" />
        
        <div class="back-home-container">
          <a href="/" class="back-home-link">トップページへ戻る</a>
        </div>
      </div>
    </section>
  </main>

  <PageTop />
</Layout>

<style is:global>
  * { box-sizing: border-box; }
  body { 
    margin: 0; padding: 0;
    background: #f8f6fc; color: #1a1528; 
    font-family: 'Helvetica Neue', Arial, sans-serif;
    overflow-x: hidden;
    min-height: 100vh;
    display: flex; flex-direction: column;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* 背景の基本アニメーション */
  .bg-layer {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover; background-position: center;
    z-index: -2; opacity: 1;
    animation: bgMovement 25s ease-in-out infinite alternate;
  }
  @keyframes bgMovement {
    0% { transform: scale(1) rotate(0deg); }
    100% { transform: scale(1.08) rotate(1deg); }
  }

  /* 🌌 共通デザインの適用枠組み（白ベース・透け感グレー） */
  .detailed-container {
    flex: 1; max-width: 900px; margin: 140px auto 60px auto; padding: 0 1.5rem; width: 100%; box-sizing: border-box;
  }
  .card-panel {
    display: flex;
    flex-direction: column;
    justify-content: flex-start; 
    background: rgba(220, 220, 230, 0.45) !important;
    border: 1px solid rgba(255, 255, 255, 0.8) !important; 
    border-radius: 20px !important; padding: 2.5rem !important; 
    backdrop-filter: blur(12px) !important; 
    -webkit-backdrop-filter: blur(12px) !important;
    box-shadow: 0 15px 35px rgba(100, 90, 130, 0.15) !important;
    overflow: hidden; box-sizing: border-box;
  }
  .program-header-block h2 { 
    font-size: 2rem !important; 
    margin-top: 0.2rem !important; 
    margin-bottom: 2rem !important; 
    color: #1a1528 !important; 
    font-weight: bold !important;
  }
  .catchphrase { 
    color: #7232e0 !important; 
    font-size: 0.95rem !important; 
    font-weight: bold !important; 
    margin: 0 !important; 
    letter-spacing: 0.1em !important; 
  }
  .divider { 
    border: 0 !important; 
    height: 1px !important; 
    background: linear-gradient(to right, rgba(114, 50, 224, 0), rgba(114, 50, 224, 0.3), rgba(114, 50, 224, 0)) !important; 
    margin: 2.5rem 0 !important; 
  }
  .back-home-container { text-align: center !important; margin-top: 4rem !important; }
  .back-home-link { 
    color: #554a66 !important; 
    text-decoration: none !important; 
    font-size: 0.95rem !important; 
    font-weight: 600 !important;
    display: inline-block !important; 
    transition: color 0.3s !important;
  }
  .back-home-link:hover { color: #7232e0 !important; }

  /* 📊 特商法テーブルのデザイン設定 */
  .tokushouho-table-wrapper { width: 100%; overflow-x: auto; margin-top: 1rem; }
  .tokushouho-table { 
    width: 100%; 
    border-collapse: separate; 
    border-spacing: 0; 
    border: 1px solid rgba(114, 50, 224, 0.2); 
    border-radius: 12px; 
    overflow: hidden; 
    background: rgba(255, 255, 255, 0.8); 
    box-shadow: 0 4px 15px rgba(130, 110, 160, 0.08);
  }
  .tokushouho-table th, .tokushouho-table td { 
    padding: 1.25rem 1.5rem; 
    font-size: 0.95rem; 
    line-height: 1.7; 
    border-bottom: 1px solid rgba(114, 50, 224, 0.15); 
    text-align: left; 
  }
  .tokushouho-table tr:last-child th, .tokushouho-table tr:last-child td { border-bottom: none; }
  .tokushouho-table th { 
    width: 30%; 
    background: rgba(114, 50, 224, 0.08); 
    color: #5028c6; 
    font-weight: bold; 
    white-space: nowrap; 
  }
  .tokushouho-table td { 
    width: 70%; 
    color: #251f36; 
    font-weight: 500;
  }
  .table-notice { 
    display: block; 
    color: #554a66; 
    font-size: 0.85rem; 
    margin-top: 0.4rem; 
    font-weight: normal;
  }
  
  .markdown-content a { 
    color: #5028c6 !important; 
    text-decoration: none !important; 
    font-weight: bold !important; 
    border-bottom: 1px dashed rgba(80, 40, 198, 0.6) !important; 
    transition: all 0.3s ease !important;
  }
  .markdown-content a:hover { 
    color: #7232e0 !important; 
    border-bottom: 1px solid #7232e0 !important; 
  }

  @media (max-width: 768px) {
    .detailed-container { margin-top: 120px; }
    .card-panel { padding: 1.5rem !important; }
    .program-header-block h2 { font-size: 1.6rem !important; }
    .tokushouho-table tr { display: flex; flex-direction: column; width: 100%; }
    .tokushouho-table th, .tokushouho-table td { width: 100% !important; box-sizing: border-box; }
    .tokushouho-table th { border-bottom: none; padding-bottom: 0.5rem; }
    .tokushouho-table td { padding-top: 0.5rem; }
  }
</style>