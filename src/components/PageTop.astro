<!-- ページトップ戻るボタン -->
<button id="page-top-btn" class="page-top-scroll-btn" aria-label="ページトップへ戻る">
  <span class="arrow"></span>
</button>

<style>
  /* ボタンの基本スタイル（最初は非表示・スマホ/タブレットは右下固定） */
  .page-top-scroll-btn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 2px solid #8c52ff;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: all 0.3s ease-in-out;
    box-shadow: 0 4px 15px rgba(130, 110, 160, 0.15);
  }

  /* PC表示の時だけ中央枠の右横・下側に配置 */
  @media (min-width: 1221px) {
    .page-top-scroll-btn {
      top: auto;
      bottom: 40px;
      left: calc(50% + 505px);
      right: auto;
      transform: translateY(20px);
    }

    .page-top-scroll-btn.show {
      transform: translateY(0);
    }

    .page-top-scroll-btn:hover {
      transform: translateY(-3px);
    }
  }

  /* 上向き矢印の形 */
  .page-top-scroll-btn .arrow {
    width: 12px;
    height: 12px;
    border-top: 3px solid #8c52ff;
    border-left: 3px solid #8c52ff;
    transform: translateY(2px) rotate(45deg);
    transition: border-color 0.3s;
  }

  /* スクロールされて表示状態になった時のクラス */
  .page-top-scroll-btn.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* ホバー（マウスを乗せた時）のエフェクト */
  .page-top-scroll-btn:hover {
    background: #8c52ff;
    box-shadow: 0 0 20px rgba(140, 82, 255, 0.4);
  }
  .page-top-scroll-btn:hover .arrow {
    border-top-color: #ffffff;
    border-left-color: #ffffff;
  }

  /* スマホの時は少し小さく＆位置を調整 */
  @media (max-width: 600px) {
    .page-top-scroll-btn {
      bottom: 20px;
      right: 20px;
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  function initPageTop() {
    const topBtn = document.getElementById('page-top-btn');
    if (!topBtn) return;

    const toggleVisibility = () => {
      if (window.scrollY > 400) {
        topBtn.classList.add('show');
      } else {
        topBtn.classList.remove('show');
      }
    };

    // 重複登録防止
    if (!topBtn.dataset.bound) {
      window.addEventListener('scroll', toggleVisibility, { passive: true });

      topBtn.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });

      topBtn.dataset.bound = 'true';
    }

    toggleVisibility();
  }

  initPageTop();
  document.addEventListener('astro:page-load', initPageTop);
  document.addEventListener('astro:after-swap', initPageTop);
</script>